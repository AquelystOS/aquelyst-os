# Streamlit Cloud secrets template
# Copy this to .streamlit/secrets.toml LOCALLY (never commit it)
# In Streamlit Cloud: paste the contents into Settings → Secrets

# Team password — required for protected URL
# Anyone visiting the public URL needs this to enter
TEAM_PASSWORD = "change-this-to-something-strong"

# Cerebras AI key (from cloud.cerebras.ai)
CEREBRAS_API_KEY = "csk-..."

# Optional: Claude API key (anthropic.com)
# CLAUDE_API_KEY = "sk-ant-..."

# Optional: OpenAI API key
# OPENAI_API_KEY = "sk-..."

# Web3Forms key (already public-safe but keep here for consistency)
WEB3FORMS_KEY = "993ac019-1740-49b2-866c-e1fb4cf4aa15"
